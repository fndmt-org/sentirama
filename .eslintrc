{
    "extends": "react-app",
    "env": {
      "browser": true,
      "node": true
    },
    "globals": {
      "describe": false,
      "it": false,
      "before": false,
      "beforeEach": false,
      "after": false
    },
    "rules": {
      "no-console": "off",
      "max-len": ["error", 125],
      "padded-blocks": "off",
      "no-use-before-define": ["error", "nofunc"],
      "complexity": ["error", 8],
      "max-params": ["error", 3],
      "max-statements": ["error", 10],
      "template-curly-spacing": "off",
      "indent": ["error", 4, {
        "ignoredNodes": ["TemplateLiteral"]
      }],
      "class-methods-use-this": "off",
      "react/jsx-uses-react": 2,
      "react/jsx-uses-vars": 2,
      "import/named": 0,
      "prefer-object-spread": 0
    },
    "settings": {
      "import/resolver": {
        "alias": [
            ["@src", "./src/"]
        ]
      }
    }
  }
